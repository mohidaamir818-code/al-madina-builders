# Copy to .env.local and fill in values. Never commit .env.local.

# Admin login identity (must match login form email)
ADMIN_EMAIL=your-admin@email.com

# bcrypt hash — prefer data/.admin-password.hash (script writes it automatically).
# If using env only, escape every $ as $$  e.g. $$2b$$10$$....
#   node scripts/hash-admin-password.mjs "YourStrongPassword"
ADMIN_PASSWORD_HASH=

# Long random string for signing session + OTP cookies (min 16 chars)
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret

# --- Email OTP (pick ONE provider) ---

# Option A: Resend
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM=Al Madina Admin <noreply@yourdomain.com>

# Option B: SMTP (Nodemailer)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Al Madina Admin <noreply@yourdomain.com>

# If neither Resend nor SMTP is set, OTP / contact emails are printed to the server console in development only.
# Buyer contact forms email inquiries to site.email (almadinabuildersmultan@gmail.com).
# Optional override for From header on contact emails:
# CONTACT_FROM=Al Madina Website <noreply@yourdomain.com>

# --- Google Maps (admin Add/Edit Property location picker) ---
# Google Cloud Console → enable: Maps JavaScript API + Places API
GOOGLE_MAPS_API_KEY=

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Storage baskets (created via supabase/storage.sql):
#   property-images  → photos
#   property-videos  → videos
# Admin uploads use /api/admin/upload → these buckets.
